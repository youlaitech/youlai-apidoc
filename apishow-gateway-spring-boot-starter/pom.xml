<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.youlai</groupId>
        <artifactId>apishow-parent</artifactId>
        <version>0.4.0</version>
    </parent>

    <!-- 网关聚合 Starter：在 Gateway 网关上引入，聚合各微服务 OpenAPI 文档 -->
    <artifactId>apishow-gateway-spring-boot-starter</artifactId>

    <name>apishow-gateway-spring-boot-starter</name>
    <description>apishow 网关聚合 Starter — Spring Cloud Gateway + WebFlux</description>

    <properties>
        <!-- 仅用于本模块编译期解析 spring-cloud BOM；使用方（网关项目）自行管理自己的 spring-cloud 版本 -->
        <spring-cloud.bom.version>2025.0.0</spring-cloud.bom.version>
    </properties>

    <!-- dependencyManagement 不随依赖传递，只影响本模块构建 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 核心模块：前端静态资源 + 配置属性 + 工具类 -->
        <dependency>
            <groupId>tech.youlai</groupId>
            <artifactId>apishow-core</artifactId>
        </dependency>
        <!-- Spring Cloud Gateway（基于 WebFlux） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 入口控制器用 springdoc 传递的 @Hidden 排除在 OpenAPI 文档外，版本与宿主 springdoc 对齐 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- ApishowGatewayProperties 使用 @Data 生成 getter -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- 配置属性元数据（编译期生成 ApishowGatewayProperties 的 IDE 提示） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>${spring-boot.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
