<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.youlai</groupId>
        <artifactId>apidoc4j-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <!-- 网关聚合 Starter：在 Gateway 网关上引入，聚合各微服务 OpenAPI 文档 -->
    <artifactId>apidoc4j-gateway-spring-boot-starter</artifactId>

    <name>apidoc4j-gateway-spring-boot-starter</name>
    <description>apidoc4j 网关聚合 Starter — Spring Cloud Gateway + WebFlux</description>
    <url>https://github.com/youlaitech/youlai-apidoc</url>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>youlai</name>
            <email>youlaitech@163.com</email>
            <url>https://www.youlai.tech</url>
            <organization>youlai</organization>
            <organizationUrl>https://www.youlai.tech</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/youlaitech/youlai-apidoc</url>
        <connection>scm:git:https://github.com/youlaitech/youlai-apidoc.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/youlaitech/youlai-apidoc.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- 仅用于本模块编译期解析 spring-cloud BOM；使用方（网关项目）自行管理自己的 spring-cloud 版本 -->
        <spring-cloud.bom.version>2025.0.0</spring-cloud.bom.version>
    </properties>

    <!-- dependencyManagement 不随依赖传递，只影响本模块构建 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 核心模块：前端静态资源 + 配置属性 + 工具类 -->
        <dependency>
            <groupId>tech.youlai</groupId>
            <artifactId>apidoc4j-core</artifactId>
        </dependency>
        <!-- Spring Cloud Gateway（基于 WebFlux） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- GatewayDocProperties 使用 @Data 生成 getter -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- 配置属性元数据（编译期生成 GatewayDocProperties 的 IDE 提示） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>${spring-boot.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
